{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://config/easa_requirements_matrix.schema.json",
  "title": "Governed EASA annual submission inventory",
  "type": "object",
  "required": ["schema_version", "matrix_id", "matrix_status", "scope", "governance", "coverage_policy", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_status": {"enum": ["BLOCKED_NO_APPROVED_INVENTORY", "APPROVED"]},
    "is_synthetic": {"type": "boolean"},
    "scope": {
      "type": "object",
      "required": ["airport_group_size", "airport_selection", "jurisdictions"],
      "properties": {
        "airport_group_size": {"const": 18},
        "airport_selection": {"type": "string", "minLength": 1},
        "jurisdictions": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["compliance_owner", "legal_owner", "data_owner", "approval_required", "official_interface_required_for_transmission", "explicit_transmission_authorization_required", "default_action"],
      "properties": {
        "compliance_owner": {"type": "string", "minLength": 1},
        "legal_owner": {"type": "string", "minLength": 1},
        "data_owner": {"type": "string", "minLength": 1},
        "approval_required": {"const": true},
        "official_interface_required_for_transmission": {"const": true},
        "explicit_transmission_authorization_required": {"const": true},
        "default_action": {"const": "BLOCK_EXPORT_AND_TRANSMISSION"}
      },
      "additionalProperties": false
    },
    "coverage_policy": {
      "type": "object",
      "required": ["target_percent", "denominator", "numerator", "unverified_rows_contribute_to_coverage", "status_when_denominator_is_zero"],
      "properties": {
        "target_percent": {"type": "number", "minimum": 78, "maximum": 100},
        "denominator": {"const": "COMPLIANCE_OWNER_APPROVED_ANNUAL_SUBMISSION_INVENTORY"},
        "numerator": {"const": "APPROVED_INVENTORY_ROWS_WITH_AUTOMATION_ELIGIBILITY_ELIGIBLE"},
        "unverified_rows_contribute_to_coverage": {"const": false},
        "status_when_denominator_is_zero": {"const": "BLOCKED_NO_APPROVED_INVENTORY"}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["requirement_id", "regulation", "submission", "airport", "authority", "frequency", "annual_submission_count", "deadline", "source_fields", "validation_rules", "output_format", "automation_eligibility", "approval_status", "inventory_approved", "official_interface", "compliance_owner_signoff", "manual_reason"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "regulation": {"type": "string", "minLength": 1},
        "submission": {"type": "string", "minLength": 1},
        "airport": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "frequency": {"type": "string", "minLength": 1},
        "annual_submission_count": {"type": ["integer", "null"], "minimum": 1},
        "deadline": {
          "type": "object",
          "required": ["rule", "timezone", "calendar"],
          "properties": {
            "rule": {"type": "string", "minLength": 1},
            "timezone": {"type": "string", "minLength": 1},
            "calendar": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "source_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rule_id", "rule_type", "definition", "severity", "sql_expression"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "rule_type": {"enum": ["RECONCILIATION", "COMPLETENESS", "VALIDITY", "DUPLICATE", "TIMELINESS", "CROSS_FIELD", "TODO_VERIFY"]},
              "definition": {"type": "string", "minLength": 1},
              "severity": {"enum": ["BLOCKING", "WARNING"]},
              "sql_expression": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "output_format": {"type": "string", "minLength": 1},
        "automation_eligibility": {"enum": ["ELIGIBLE", "MANUAL", "NOT_ELIGIBLE_UNVERIFIED"]},
        "approval_status": {"enum": ["APPROVED", "PENDING_COMPLIANCE_OWNER", "REJECTED", "EXPIRED"]},
        "inventory_approved": {"type": "boolean"},
        "official_interface": {
          "type": "object",
          "required": ["documented", "reference", "transmission_authorized", "authorization_reference"],
          "properties": {
            "documented": {"type": "boolean"},
            "reference": {"type": "string"},
            "transmission_authorized": {"type": "boolean"},
            "authorization_reference": {"type": "string"}
          },
          "additionalProperties": false
        },
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "effective_to": {"type": ["string", "null"], "format": "date"},
        "compliance_owner_signoff": {
          "type": "object",
          "required": ["approved_by", "approved_at_utc", "evidence_reference"],
          "properties": {
            "approved_by": {"type": ["string", "null"]},
            "approved_at_utc": {"type": ["string", "null"], "format": "date-time"},
            "evidence_reference": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "manual_reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}