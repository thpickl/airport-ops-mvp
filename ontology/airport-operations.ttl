    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_terminal" ;
    ao:sourceView "ops.vw_dim_terminal" ;
    ao:warehouseGrain "one row per terminal" .

ao:TerminalFlowSummary a owl:Class ;
