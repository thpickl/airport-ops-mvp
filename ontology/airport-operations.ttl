ao:TimeDimensionRecord a owl:Class ;
    rdfs:label "Time Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per hour from 0 through 23."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "hour_key" ;
