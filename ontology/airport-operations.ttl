@prefix ao: <https://data.fictional-airport-group.example/airport-operations/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ao:Aircraft a owl:Class ;
    rdfs:label "Aircraft"@en ;
    rdfs:comment "Compatibility name retained from the existing base ontology; the source grain is aircraft type."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AircraftType ;
    owl:deprecated true ;
    owl:equivalentClass ao:AircraftType .

ao:AircraftFleet a owl:Class ;
    rdfs:label "Aircraft Fleet"@en ;
    rdfs:comment "Compatibility name retained from the existing enterprise ontology."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AircraftInstance .

ao:AircraftFleetDimensionRecord a owl:Class ;
    rdfs:label "Aircraft Fleet Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per aircraft instance."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "aircraft_instance_id" ;
    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_aircraft_fleet" ;
    ao:sourceView "ops.vw_dim_aircraft_fleet" ;
    ao:warehouseGrain "one row per aircraft instance" .

ao:AircraftRotationFactRecord a owl:Class ;
    rdfs:label "Aircraft Rotation Fact Record"@en ;
    rdfs:comment "Warehouse fact record at one row per aircraft rotation sequence and flight."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:FactRecord ;
    ao:foreignKey "aircraft_instance_id -> dim_aircraft_fleet.aircraft_instance_id",
        "flight_event_id -> fact_flight_turnaround_events.flight_event_id" ;
    ao:primaryKey "rotation_id" ;
    ao:sourceTable "fact_aircraft_rotation" ;
    ao:warehouseGrain "one row per aircraft rotation sequence and flight" .

ao:AircraftRotationKPI a owl:Class ;
    rdfs:label "Aircraft Rotation KPI"@en ;
    rdfs:comment "Gold analytical product at one row per airport and day."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AggregateProduct ;
    ao:sourceTable "gold_aircraft_rotation_kpi" ;
    ao:sourceView "ops.vw_aircraft_rotation_kpi" ;
    ao:warehouseGrain "one row per airport and day" .

ao:AircraftTypeDimensionRecord a owl:Class ;
    rdfs:label "Aircraft Type Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per aircraft type."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "aircraft_type_id" ;
    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_aircraft" ;
    ao:sourceView "ops.vw_dim_aircraft" ;
    ao:warehouseGrain "one row per aircraft type" .

ao:AirlineDimensionRecord a owl:Class ;
    rdfs:label "Airline Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per airline reference."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "airline_id" ;
    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_airline" ;
    ao:sourceView "ops.vw_dim_airline" ;
    ao:warehouseGrain "one row per airline reference" .

ao:AirlineRoutePerformance a owl:Class ;
    rdfs:label "Airline Route Performance"@en ;
