    rdfs:comment "Gold analytical product at one row per zone."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AggregateProduct ;
    ao:sourceTable "gold_spatial_operational_status" ;
    ao:sourceView "ops.vw_spatial_operational_context" ;
    ao:warehouseGrain "one row per zone" .

ao:StandDimensionRecord a owl:Class ;
    rdfs:label "Stand Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per aircraft stand."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "stand_id" ;
    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_stand" ;
    ao:sourceView "ops.vw_dim_stand" ;
    ao:warehouseGrain "one row per aircraft stand" .

ao:TerminalDimensionRecord a owl:Class ;
    rdfs:label "Terminal Dimension Record"@en ;
