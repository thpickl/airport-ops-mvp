    ao:sourceView "ops.vw_dim_time" ;
    ao:warehouseGrain "one row per hour from 0 through 23" .

ao:TurnaroundPhase a owl:Class ;
    rdfs:label "Turnaround Phase"@en ;
    rdfs:comment "One of five deterministic phase milestones within a flight turnaround."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:OperationalEvent ;
    ao:primaryKey "phase_event_id" ;
    ao:sourceTable "fact_turnaround_phase" ;
    ao:sourceView "ops.vw_fact_turnaround_phase" ;
    ao:warehouseGrain "one row per flight and turnaround phase" .

ao:TurnaroundPhaseFactRecord a owl:Class ;
    rdfs:label "Turnaround Phase Fact Record"@en ;
