    rdfs:subClassOf ao:OperationalEvent ;
    ao:primaryKey "bag_token" ;
    ao:sourceTable "fact_baggage_journey" ;
    ao:sourceView "ops.vw_fact_baggage_journey" ;
    ao:warehouseGrain "one row per synthetic checked bag" .

ao:BaggageJourneyFactRecord a owl:Class ;
