    ao:sourceView "ops.vw_airline_route_performance" ;
    ao:warehouseGrain "one row per airline and route" .

ao:AirportDimensionRecord a owl:Class ;
    rdfs:label "Airport Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per airport."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "airport_id" ;
    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_airport" ;
    ao:sourceView "ops.vw_dim_airport" ;
    ao:warehouseGrain "one row per airport" .

ao:AirportOperationalHealth a owl:Class ;
    rdfs:label "Airport Operational Health"@en ;
    rdfs:comment "Gold analytical product at one row per airport."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AggregateProduct ;
    ao:sourceTable "gold_airport_operational_health" ;
    ao:sourceView "ops.vw_airport_performance" ;
    ao:warehouseGrain "one row per airport" .

ao:AssetDimensionRecord a owl:Class ;
    rdfs:label "Asset Dimension Record"@en ;
    rdfs:comment "Warehouse dimension record at one row per maintainable asset or meter."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DimensionRecord ;
    ao:primaryKey "asset_id" ;
    ao:scdSemantics "current-state overwrite; no effective_from/effective_to columns" ;
    ao:sourceTable "dim_asset" ;
    ao:sourceView "ops.vw_dim_asset" ;
    ao:warehouseGrain "one row per maintainable asset or meter" .

ao:AssetInspection a owl:Class ;
    rdfs:label "Asset Inspection"@en ;
    rdfs:comment "A synthetic asset inspection with score, status, and follow-up flag."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:OperationalEvent ;
    ao:primaryKey "inspection_id" ;
    ao:sourceTable "fact_asset_inspection" ;
    ao:warehouseGrain "one row per asset inspection" .

ao:AssetInspectionFactRecord a owl:Class ;
    rdfs:label "Asset Inspection Fact Record"@en ;
    rdfs:comment "Warehouse fact record at one row per asset inspection."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:FactRecord ;
    ao:foreignKey "asset_id -> dim_asset.asset_id" ;
    ao:primaryKey "inspection_id" ;
    ao:sourceTable "fact_asset_inspection" ;
    ao:warehouseGrain "one row per asset inspection" .

ao:AssetLocationBridgeRecord a owl:Class ;
    rdfs:label "Asset Location Bridge Record"@en ;
    rdfs:comment "Warehouse bridge record at one row per asset and location assignment."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:BridgeRecord ;
    ao:foreignKey "asset_id -> dim_asset.asset_id",
        "location_id -> dim_location.location_id" ;
    ao:primaryKey "asset_id + location_id" ;
    ao:scdSemantics "effective_from, effective_to, and is_current are implemented; generator currently emits only current rows" ;
    ao:sourceTable "bridge_asset_location" ;
    ao:warehouseGrain "one row per asset and location assignment" .

ao:AssetReliability a owl:Class ;
    rdfs:label "Asset Reliability"@en ;
    rdfs:comment "Gold analytical product at one row per asset."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AggregateProduct ;
    ao:sourceTable "gold_asset_reliability" ;
    ao:sourceView "ops.vw_asset_reliability" ;
    ao:warehouseGrain "one row per asset" .

ao:AssetStateFactRecord a owl:Class ;
    rdfs:label "Asset State Fact Record"@en ;
    rdfs:comment "Warehouse fact record at one row per asset and six-hour observation."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:FactRecord ;
    ao:foreignKey "asset_id -> dim_asset.asset_id" ;
    ao:primaryKey "asset_state_id" ;
    ao:sourceTable "fact_asset_state" ;
    ao:sourceView "ops.vw_fact_asset_state" ;
    ao:warehouseGrain "one row per asset and six-hour observation" .

ao:BaggageJourney a owl:Class ;
    rdfs:label "Baggage Journey"@en ;
