ao:Flight a owl:Class ;
    rdfs:label "Flight"@en ;
    rdfs:comment "Compatibility name retained from the existing base ontology; the source grain is a flight turnaround event."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
