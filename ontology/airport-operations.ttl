    owl:inverseOf ao:originForRoute .

ao:rotationForFlight a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "rotation for flight"@en ;
    rdfs:comment "Rotation assigns one flight operation."@en ;
    rdfs:domain ao:AircraftRotation ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:FlightOperation ;
    owl:inverseOf ao:flightHasRotation .

ao:rotationUsesAircraft a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "rotation uses aircraft"@en ;
    rdfs:comment "Rotation assigns one aircraft instance."@en ;
    rdfs:domain ao:AircraftRotation ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:AircraftInstance ;
    owl:inverseOf ao:aircraftHasRotation .

ao:routeOperatedByAirline a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "route operated by airline"@en ;
    rdfs:comment "Route service assumption names one airline."@en ;
    rdfs:domain ao:Route ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:Airline ;
    owl:inverseOf ao:airlineOperatesRoute .

ao:servedAtGate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "served at gate"@en ;
    rdfs:comment "Flight operation occurs at one gate."@en ;
    rdfs:domain ao:FlightOperation ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:Gate ;
    owl:inverseOf ao:servesFlight .

ao:standServedByGate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "stand served by gate"@en ;
    rdfs:comment "Stand is served by one gate in the current bridge."@en ;
    rdfs:domain ao:Stand ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:Gate ;
    owl:inverseOf ao:servesStand .

ao:terminalOfAirport a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "terminal of airport"@en ;
    rdfs:comment "Terminal belongs to one airport."@en ;
    rdfs:domain ao:Terminal ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:Airport ;
    rdfs:subPropertyOf ao:containedIn ;
    owl:inverseOf ao:hasTerminal .

ao:turnaroundOfFlight a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "turnaround of flight"@en ;
    rdfs:comment "Turnaround corresponds to one flight operation."@en ;
    rdfs:domain ao:Turnaround ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:FlightOperation ;
    owl:inverseOf ao:hasTurnaround .

ao:usesAircraftType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "uses aircraft type"@en ;
    rdfs:comment "Flight operation uses one aircraft type."@en ;
    rdfs:domain ao:FlightOperation ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:AircraftType ;
    owl:inverseOf ao:aircraftTypeUsedByFlight .

ao:zoneOfTerminal a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "zone of terminal"@en ;
    rdfs:comment "Zone belongs to one terminal."@en ;
    rdfs:domain ao:Zone ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:Terminal ;
    rdfs:subPropertyOf ao:containedIn ;
    owl:inverseOf ao:hasZone .

ao:MaintenanceWorkOrder a owl:Class ;
    rdfs:label "Maintenance Work Order"@en ;
    rdfs:comment "A synthetic analytical maintenance work order requiring governed approval metadata."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:OperationalEvent ;
    ao:primaryKey "work_order_id" ;
    ao:sourceTable "fact_maintenance_work_order" ;
    ao:warehouseGrain "one row per maintenance work order" .

ao:OperationalIncident a owl:Class ;
    rdfs:label "Operational Incident"@en ;
    rdfs:comment "A synthetic operational incident; it is not a real safety or security record."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:OperationalEvent ;
    ao:ambiguityNote "delay_reason is a primary narrative cause; the source does not implement an atomic many-cause delay bridge." ;
    ao:primaryKey "incident_id" ;
    ao:sourceTable "fact_operational_incidents" ;
    ao:sourceView "ops.vw_incident_details" ;
    ao:warehouseGrain "one row per operational incident" .

ao:Stand a owl:Class ;
    rdfs:label "Stand"@en ;
    rdfs:comment "A synthetic aircraft parking position served by a gate."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Gate ;
            owl:onProperty ao:standServedByGate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:PhysicalLocation ;
    ao:primaryKey "stand_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_stand" ;
    ao:sourceView "ops.vw_dim_stand" ;
    ao:warehouseGrain "one row per aircraft stand" .

ao:AircraftInstance a owl:Class ;
    rdfs:label "Aircraft Instance"@en ;
    rdfs:comment "A synthetic aircraft instance identified by a tail token."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:PhysicalAsset ;
    ao:primaryKey "aircraft_instance_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_aircraft_fleet" ;
    ao:sourceView "ops.vw_dim_aircraft_fleet" ;
    ao:warehouseGrain "one row per synthetic aircraft instance" .

ao:AircraftRotation a owl:Class ;
    rdfs:label "Aircraft Rotation"@en ;
    rdfs:comment "A sequenced assignment of an aircraft instance to a flight."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:FlightOperation ;
            owl:onProperty ao:rotationForFlight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:AircraftInstance ;
            owl:onProperty ao:rotationUsesAircraft ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:OperationalEvent ;
    ao:primaryKey "rotation_id" ;
    ao:sourceTable "fact_aircraft_rotation" ;
    ao:warehouseGrain "one row per aircraft rotation sequence and flight" .

ao:Checkpoint a owl:Class ;
    rdfs:label "Checkpoint"@en ;
    rdfs:comment "A synthetic passenger processing checkpoint within a zone."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Zone ;
            owl:onProperty ao:checkpointOfZone ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:PhysicalLocation ;
    ao:primaryKey "checkpoint_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_checkpoint" ;
    ao:sourceView "ops.vw_dim_checkpoint" ;
    ao:warehouseGrain "one row per passenger checkpoint" .

ao:PassengerFlowObservation a owl:Class ;
    rdfs:label "Passenger Flow Observation"@en ;
    rdfs:comment "A PII-free aggregate checkpoint queue observation at 15-minute grain."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:Observation ;
    ao:primaryKey "queue_metric_id" ;
    ao:sourceTable "fact_passenger_queue_metrics" ;
    ao:sourceView "ops.vw_fact_passenger_flow" ;
    ao:warehouseGrain "one row per checkpoint and 15-minute interval" .

ao:Turnaround a owl:Class ;
    rdfs:label "Turnaround"@en ;
    rdfs:comment "The ground-operation interval associated one-to-one with a flight operation in the base fact."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:FlightOperation ;
            owl:onProperty ao:turnaroundOfFlight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:OperationalEvent ;
    ao:primaryKey "flight_event_id" ;
    ao:sourceTable "fact_flight_turnaround_events" ;
    ao:sourceView "ops.vw_fact_turnaround" ;
    ao:warehouseGrain "one row per flight turnaround event" .

ao:AircraftType a owl:Class ;
    rdfs:label "Aircraft Type"@en ;
    rdfs:comment "A public aircraft-type reference with synthetic operating assumptions."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:BusinessEntity ;
    ao:primaryKey "aircraft_type_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_aircraft" ;
    ao:sourceView "ops.vw_dim_aircraft" ;
    ao:warehouseGrain "one row per aircraft type" .

ao:AnalyticalRecord a owl:Class ;
    rdfs:label "Analytical Record"@en ;
    rdfs:comment "A record in the conformed Warehouse or Gold analytical model."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:InformationArtifact .

ao:MeasureDefinition a owl:Class ;
    rdfs:label "Measure Definition"@en ;
    rdfs:comment "A governed KPI or measure definition with formula, unit, grain, and caveats."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:InformationArtifact ;
    ao:ambiguityNote "semantic-model/measures.dax is authoritative; gold_kpi_catalog formula text is descriptive metadata." .

ao:containedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "contained in"@en ;
    rdfs:comment "Inverse of physical containment."@en ;
    rdfs:domain ao:DomainEntity ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:PhysicalLocation ;
    owl:inverseOf ao:contains .

ao:contains a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment "Transitive physical containment relation."@en ;
    rdfs:domain ao:PhysicalLocation ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range ao:DomainEntity ;
    owl:inverseOf ao:containedIn .

ao:Airline a owl:Class ;
    rdfs:label "Airline"@en ;
    rdfs:comment "A public airline reference entity used by fictional schedules and routes."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:BusinessEntity ;
    ao:primaryKey "airline_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_airline" ;
    ao:sourceView "ops.vw_dim_airline" ;
    ao:warehouseGrain "one row per airline" .

ao:MeasureObservation a owl:Class ;
    rdfs:label "Measure Observation"@en ;
    rdfs:comment "A numeric observation of a governed measure for a subject and timestamp."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AnalyticalRecord .

ao:PhysicalAsset a owl:Class ;
    rdfs:label "Physical Asset"@en ;
    rdfs:comment "A physical item, equipment instance, meter, or aircraft instance."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DomainEntity ;
    owl:disjointWith ao:BusinessEntity,
        ao:Observation,
        ao:OperationalEvent .

ao:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "A synthetic maintainable airport asset."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Zone ;
            owl:onProperty ao:assetLocatedInZone ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:PhysicalAsset ;
    ao:ambiguityNote "dim_asset contains zone_id, gate_id, terminal_id, and airport_id; bridge_asset_location is the effective-dated spatial assignment authority." ;
    ao:primaryKey "asset_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_asset" ;
    ao:sourceView "ops.vw_dim_asset" ;
    ao:warehouseGrain "one row per maintainable asset or energy meter" .

ao:BridgeRecord a owl:Class ;
    rdfs:label "Bridge Record"@en ;
    rdfs:comment "An explicit relationship record connecting dimensions or facts."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AnalyticalRecord .

ao:Airport a owl:Class ;
    rdfs:label "Airport"@en ;
    rdfs:comment "A public geographic airport anchor participating in a fictional demonstration portfolio."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ao:Terminal ;
            owl:onProperty ao:hasTerminal ],
        ao:PhysicalLocation ;
    ao:primaryKey "airport_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_airport" ;
    ao:sourceView "ops.vw_dim_airport" ;
    ao:warehouseGrain "one row per airport" .

ao:Gate a owl:Class ;
    rdfs:label "Gate"@en ;
    rdfs:comment "A synthetic aircraft gate belonging to an airport terminal."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Terminal ;
            owl:onProperty ao:gateOfTerminal ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:PhysicalLocation ;
    ao:primaryKey "gate_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_gate" ;
    ao:sourceView "ops.vw_dim_gate" ;
    ao:warehouseGrain "one row per gate" .

ao:Route a owl:Class ;
    rdfs:label "Route"@en ;
    rdfs:comment "A fictional origin, destination, and airline service assumption."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Airport ;
            owl:onProperty ao:destinationAirport ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:Airport ;
            owl:onProperty ao:originAirport ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:Airline ;
            owl:onProperty ao:routeOperatedByAirline ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:BusinessEntity ;
    ao:primaryKey "route_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_route" ;
    ao:sourceView "ops.vw_dim_route" ;
    ao:warehouseGrain "one row per fictional route" .

ao:PhysicalLocation a owl:Class ;
    rdfs:label "Physical Location"@en ;
    rdfs:comment "A geographic or built-environment location in the airport hierarchy."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DomainEntity ;
    owl:disjointWith ao:BusinessEntity,
        ao:Observation,
        ao:OperationalEvent,
        ao:PhysicalAsset .

ao:Terminal a owl:Class ;
    rdfs:label "Terminal"@en ;
    rdfs:comment "A synthetic passenger terminal contained by one airport."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Airport ;
            owl:onProperty ao:terminalOfAirport ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:PhysicalLocation ;
    ao:primaryKey "terminal_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_terminal" ;
    ao:sourceView "ops.vw_dim_terminal" ;
    ao:warehouseGrain "one row per terminal" .

ao:Zone a owl:Class ;
    rdfs:label "Zone"@en ;
    rdfs:comment "A synthetic indoor processing or secure-operations zone within a terminal."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Terminal ;
            owl:onProperty ao:zoneOfTerminal ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:PhysicalLocation ;
    ao:primaryKey "zone_id" ;
    ao:scdSemantics "current-state overwrite; no effective dating" ;
    ao:sourceTable "dim_zone" ;
    ao:sourceView "ops.vw_dim_zone" ;
    ao:warehouseGrain "one row per indoor zone" .

ao:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "A synthetic measurement or status observation at a declared grain."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DomainEntity .

ao:BusinessEntity a owl:Class ;
    rdfs:label "Business Entity"@en ;
    rdfs:comment "An organizational, commercial, workforce, route, or reference concept."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DomainEntity ;
    owl:disjointWith ao:Observation,
        ao:OperationalEvent .

ao:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:comment "Stable source-system or ontology identifier."@en ;
    rdfs:domain ao:DomainEntity ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:range xsd:string .

ao:OperationalEvent a owl:Class ;
    rdfs:label "Operational Event"@en ;
    rdfs:comment "A time-bounded synthetic operational occurrence or assignment."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:DomainEntity ;
    owl:disjointWith ao:Observation .

ao:DomainEntity a owl:Class ;
    rdfs:label "Domain Entity"@en ;
    rdfs:comment "A physical, business, operational, or observational concept represented by the airport-operations domain."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> .

ao:FlightOperation a owl:Class ;
    rdfs:label "Flight Operation"@en ;
    rdfs:comment "A fictional scheduled flight movement represented by a turnaround fact."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ao:Route ;
            owl:onProperty ao:flightOnRoute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:Airline ;
            owl:onProperty ao:flightOperatedByAirline ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:Turnaround ;
            owl:onProperty ao:hasTurnaround ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:Gate ;
            owl:onProperty ao:servedAtGate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ao:AircraftType ;
            owl:onProperty ao:usesAircraftType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ao:OperationalEvent ;
    ao:primaryKey "flight_event_id" ;
    ao:sourceTable "fact_flight_turnaround_events" ;
    ao:sourceView "ops.vw_fact_turnaround" ;
    ao:warehouseGrain "one row per flight turnaround event" .

ao:AggregateProduct a owl:Class ;
    rdfs:label "Aggregate Product"@en ;
    rdfs:comment "A business-ready Gold aggregate or scorecard product."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AnalyticalRecord .

ao:DimensionRecord a owl:Class ;
    rdfs:label "Dimension Record"@en ;
    rdfs:comment "A conformed descriptive record used to filter and group facts."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AnalyticalRecord ;
    owl:disjointWith ao:BridgeRecord,
        ao:FactRecord .

ao:FactRecord a owl:Class ;
    rdfs:label "Fact Record"@en ;
    rdfs:comment "A record at a declared event, transaction, assignment, or observation grain."@en ;
    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:AnalyticalRecord ;
    owl:disjointWith ao:BridgeRecord .

<https://data.fictional-airport-group.example/airport-operations/ontology> a owl:Ontology ;
    dcterms:description "OWL 2 ontology for the repository's airport physical hierarchy, operational events, warehouse star schema, and governed measures."@en ;
    dcterms:issued "2026-08-13"^^xsd:date ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:modified "2026-08-13"^^xsd:date ;
    dcterms:title "Airport Operations Fabric Ontology"@en ;
    owl:versionIRI <https://data.fictional-airport-group.example/airport-operations/ontology/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    prov:wasDerivedFrom <urn:repo:fabric-airport-ops-mvp> ;
    ao:generatorVersion "1.0.0" ;
    ao:schemaVersion "1.0.0" ;
    ao:sourceArtifact "ontology/generate_ontology.py" .

