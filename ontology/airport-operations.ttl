    rdfs:isDefinedBy <https://data.fictional-airport-group.example/airport-operations/ontology> ;
    rdfs:subClassOf ao:OperationalEvent ;
    ao:primaryKey "roster_assignment_id" ;
    ao:sourceTable "fact_employee_roster" ;
    ao:sourceView "ops.vw_fact_employee_roster" ;
    ao:warehouseGrain "one row per worker and day assignment" .

ao:EmployeeRosterFactRecord a owl:Class ;
    rdfs:label "Employee Roster Fact Record"@en ;
