<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:ao="https://data.fictional-airport-group.example/airport-operations/ontology#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AggregateProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A business-ready Gold aggregate or scorecard product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aggregate Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AnalyticalRecord" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Aircraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Compatibility name retained from the existing base ontology; the source grain is aircraft type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftType" />
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentClass rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftType" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftFleet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Compatibility name retained from the existing enterprise ontology.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Fleet</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftInstance" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftFleetDimensionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse dimension record at one row per aircraft instance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Fleet Dimension Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DimensionRecord" />
    <ao:primaryKey>aircraft_instance_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective_from/effective_to columns</ao:scdSemantics>
    <ao:sourceTable>dim_aircraft_fleet</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_aircraft_fleet</ao:sourceView>
    <ao:warehouseGrain>one row per aircraft instance</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic aircraft instance identified by a tail token.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Instance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#PhysicalAsset" />
    <ao:primaryKey>aircraft_instance_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_aircraft_fleet</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_aircraft_fleet</ao:sourceView>
    <ao:warehouseGrain>one row per synthetic aircraft instance</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftRotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A sequenced assignment of an aircraft instance to a flight.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Rotation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent" />
    <rdfs:subClassOf rdf:nodeID="restriction-AircraftRotation-rotationForFlight-exactly-1" />
    <rdfs:subClassOf rdf:nodeID="restriction-AircraftRotation-rotationUsesAircraft-exactly-1" />
    <ao:primaryKey>rotation_id</ao:primaryKey>
    <ao:sourceTable>fact_aircraft_rotation</ao:sourceTable>
    <ao:warehouseGrain>one row per aircraft rotation sequence and flight</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftRotationFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse fact record at one row per aircraft rotation sequence and flight.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Rotation Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
    <ao:foreignKey>aircraft_instance_id -&gt; dim_aircraft_fleet.aircraft_instance_id</ao:foreignKey>
    <ao:foreignKey>flight_event_id -&gt; fact_flight_turnaround_events.flight_event_id</ao:foreignKey>
    <ao:primaryKey>rotation_id</ao:primaryKey>
    <ao:sourceTable>fact_aircraft_rotation</ao:sourceTable>
    <ao:warehouseGrain>one row per aircraft rotation sequence and flight</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftRotationKPI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Gold analytical product at one row per airport and day.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Rotation KPI</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AggregateProduct" />
    <ao:sourceTable>gold_aircraft_rotation_kpi</ao:sourceTable>
    <ao:sourceView>ops.vw_aircraft_rotation_kpi</ao:sourceView>
    <ao:warehouseGrain>one row per airport and day</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A public aircraft-type reference with synthetic operating assumptions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Type</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BusinessEntity" />
    <ao:primaryKey>aircraft_type_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_aircraft</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_aircraft</ao:sourceView>
    <ao:warehouseGrain>one row per aircraft type</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AircraftTypeDimensionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse dimension record at one row per aircraft type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Aircraft Type Dimension Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DimensionRecord" />
    <ao:primaryKey>aircraft_type_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective_from/effective_to columns</ao:scdSemantics>
    <ao:sourceTable>dim_aircraft</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_aircraft</ao:sourceView>
    <ao:warehouseGrain>one row per aircraft type</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Airline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A public airline reference entity used by fictional schedules and routes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Airline</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BusinessEntity" />
    <ao:primaryKey>airline_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_airline</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_airline</ao:sourceView>
    <ao:warehouseGrain>one row per airline</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AirlineDimensionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse dimension record at one row per airline reference.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Airline Dimension Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DimensionRecord" />
    <ao:primaryKey>airline_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective_from/effective_to columns</ao:scdSemantics>
    <ao:sourceTable>dim_airline</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_airline</ao:sourceView>
    <ao:warehouseGrain>one row per airline reference</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AirlineRoutePerformance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Gold analytical product at one row per airline and route.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Airline Route Performance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AggregateProduct" />
    <ao:sourceTable>gold_airline_route_performance</ao:sourceTable>
    <ao:sourceView>ops.vw_airline_route_performance</ao:sourceView>
    <ao:warehouseGrain>one row per airline and route</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Airport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A public geographic airport anchor participating in a fictional demonstration portfolio.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Airport</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#PhysicalLocation" />
    <rdfs:subClassOf rdf:nodeID="restriction-Airport-hasTerminal-minimum-1" />
    <ao:primaryKey>airport_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_airport</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_airport</ao:sourceView>
    <ao:warehouseGrain>one row per airport</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AirportDimensionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse dimension record at one row per airport.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Airport Dimension Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DimensionRecord" />
    <ao:primaryKey>airport_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective_from/effective_to columns</ao:scdSemantics>
    <ao:sourceTable>dim_airport</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_airport</ao:sourceView>
    <ao:warehouseGrain>one row per airport</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AirportOperationalHealth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Gold analytical product at one row per airport.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Airport Operational Health</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AggregateProduct" />
    <ao:sourceTable>gold_airport_operational_health</ao:sourceTable>
    <ao:sourceView>ops.vw_airport_performance</ao:sourceView>
    <ao:warehouseGrain>one row per airport</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AnalyticalRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A record in the conformed Warehouse or Gold analytical model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Analytical Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#InformationArtifact" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Asset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic maintainable airport asset.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#PhysicalAsset" />
    <rdfs:subClassOf rdf:nodeID="restriction-Asset-assetLocatedInZone-exactly-1" />
    <ao:ambiguityNote>dim_asset contains zone_id, gate_id, terminal_id, and airport_id; bridge_asset_location is the effective-dated spatial assignment authority.</ao:ambiguityNote>
    <ao:primaryKey>asset_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_asset</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_asset</ao:sourceView>
    <ao:warehouseGrain>one row per maintainable asset or energy meter</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetDimensionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse dimension record at one row per maintainable asset or meter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset Dimension Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DimensionRecord" />
    <ao:primaryKey>asset_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective_from/effective_to columns</ao:scdSemantics>
    <ao:sourceTable>dim_asset</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_asset</ao:sourceView>
    <ao:warehouseGrain>one row per maintainable asset or meter</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetInspection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic asset inspection with score, status, and follow-up flag.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset Inspection</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent" />
    <ao:primaryKey>inspection_id</ao:primaryKey>
    <ao:sourceTable>fact_asset_inspection</ao:sourceTable>
    <ao:warehouseGrain>one row per asset inspection</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetInspectionFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse fact record at one row per asset inspection.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset Inspection Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
    <ao:foreignKey>asset_id -&gt; dim_asset.asset_id</ao:foreignKey>
    <ao:primaryKey>inspection_id</ao:primaryKey>
    <ao:sourceTable>fact_asset_inspection</ao:sourceTable>
    <ao:warehouseGrain>one row per asset inspection</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetLocationBridgeRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse bridge record at one row per asset and location assignment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset Location Bridge Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BridgeRecord" />
    <ao:foreignKey>asset_id -&gt; dim_asset.asset_id</ao:foreignKey>
    <ao:foreignKey>location_id -&gt; dim_location.location_id</ao:foreignKey>
    <ao:primaryKey>asset_id + location_id</ao:primaryKey>
    <ao:scdSemantics>effective_from, effective_to, and is_current are implemented; generator currently emits only current rows</ao:scdSemantics>
    <ao:sourceTable>bridge_asset_location</ao:sourceTable>
    <ao:warehouseGrain>one row per asset and location assignment</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetReliability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Gold analytical product at one row per asset.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset Reliability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AggregateProduct" />
    <ao:sourceTable>gold_asset_reliability</ao:sourceTable>
    <ao:sourceView>ops.vw_asset_reliability</ao:sourceView>
    <ao:warehouseGrain>one row per asset</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetStateFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse fact record at one row per asset and six-hour observation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset State Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
    <ao:foreignKey>asset_id -&gt; dim_asset.asset_id</ao:foreignKey>
    <ao:primaryKey>asset_state_id</ao:primaryKey>
    <ao:sourceTable>fact_asset_state</ao:sourceTable>
    <ao:sourceView>ops.vw_fact_asset_state</ao:sourceView>
    <ao:warehouseGrain>one row per asset and six-hour observation</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#AssetStateObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic asset health observation at six-hour grain.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Asset State Observation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#Observation" />
    <ao:primaryKey>asset_state_id</ao:primaryKey>
    <ao:sourceTable>fact_asset_state</ao:sourceTable>
    <ao:sourceView>ops.vw_fact_asset_state</ao:sourceView>
    <ao:warehouseGrain>one row per asset and six-hour interval</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#BaggageJourney">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic checked-bag journey with load, reclaim, and exception outcome.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
