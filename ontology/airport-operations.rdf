    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Maintenance Event Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
    <ao:foreignKey>airport_id -&gt; dim_airport.airport_id</ao:foreignKey>
    <ao:foreignKey>gate_id -&gt; dim_gate.gate_id</ao:foreignKey>
    <ao:primaryKey>maintenance_id</ao:primaryKey>
    <ao:sourceTable>fact_maintenance_events</ao:sourceTable>
    <ao:sourceView>ops.vw_fact_maintenance_events</ao:sourceView>
    <ao:warehouseGrain>one row per maintenance event</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#MaintenanceKPI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
