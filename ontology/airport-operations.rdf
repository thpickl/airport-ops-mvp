    <ao:primaryKey>customer_token</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_customer</ao:sourceTable>
    <ao:warehouseGrain>one row per pseudonymous customer token</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PseudonymousWorkforceMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic workforce token with no real identity fields.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Pseudonymous Workforce Member</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BusinessEntity" />
    <ao:primaryKey>employee_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_employee</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_employee</ao:sourceView>
    <ao:warehouseGrain>one row per pseudonymous workforce token</ao:warehouseGrain>
