    <ao:sourceTable>fact_ramp_service_task</ao:sourceTable>
    <ao:warehouseGrain>one row per flight and ramp task</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Recommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">An advisory-only synthetic recommendation requiring human approval.</rdfs:comment>
