  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PassengerFlowObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A PII-free aggregate checkpoint queue observation at 15-minute grain.</rdfs:comment>
