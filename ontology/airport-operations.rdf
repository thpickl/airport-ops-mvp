    <ao:sourceTable>dim_organization</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_organization</ao:sourceView>
    <ao:warehouseGrain>one row per organization unit</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#OrganizationDimensionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse dimension record at one row per organization unit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Organization Dimension Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DimensionRecord" />
    <ao:primaryKey>org_unit_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective_from/effective_to columns</ao:scdSemantics>
    <ao:sourceTable>dim_organization</ao:sourceTable>
    <ao:sourceView>ops.vw_dim_organization</ao:sourceView>
    <ao:warehouseGrain>one row per organization unit</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PassengerCohort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">An aggregate synthetic passenger segment; it is not a person identity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Passenger Cohort</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BusinessEntity" />
    <ao:ambiguityNote>Passenger and customer tokens exist in restricted facts, but agent-facing ontology mappings expose aggregate cohorts only.</ao:ambiguityNote>
    <ao:primaryKey>customer_segment_id</ao:primaryKey>
    <ao:scdSemantics>current-state overwrite; no effective dating</ao:scdSemantics>
    <ao:sourceTable>dim_customer_segment</ao:sourceTable>
    <ao:warehouseGrain>one row per customer segment</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PassengerDimensionRecord">
