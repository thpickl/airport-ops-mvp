    <ao:primaryKey>work_order_id</ao:primaryKey>
    <ao:sourceTable>fact_maintenance_work_order</ao:sourceTable>
    <ao:warehouseGrain>one row per maintenance work order</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#MaintenanceWorkOrderFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse fact record at one row per maintenance work order.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Maintenance Work Order Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
