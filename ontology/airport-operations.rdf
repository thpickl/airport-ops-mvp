  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#MaintenanceWorkOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic analytical maintenance work order requiring governed approval metadata.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Maintenance Work Order</rdfs:label>
