    <ao:sourceTable>fact_maintenance_work_order</ao:sourceTable>
    <ao:warehouseGrain>one row per maintenance work order</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#MeasureDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A governed KPI or measure definition with formula, unit, grain, and caveats.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Measure Definition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#InformationArtifact" />
    <ao:ambiguityNote>semantic-model/measures.dax is authoritative; gold_kpi_catalog formula text is descriptive metadata.</ao:ambiguityNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#MeasureObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A numeric observation of a governed measure for a subject and timestamp.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Measure Observation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#AnalyticalRecord" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Observation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic measurement or status observation at a declared grain.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DomainEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A time-bounded synthetic operational occurrence or assignment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Operational Event</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DomainEntity" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#Observation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalIncident">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic operational incident; it is not a real safety or security record.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Operational Incident</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent" />
    <ao:ambiguityNote>delay_reason is a primary narrative cause; the source does not implement an atomic many-cause delay bridge.</ao:ambiguityNote>
    <ao:primaryKey>incident_id</ao:primaryKey>
    <ao:sourceTable>fact_operational_incidents</ao:sourceTable>
    <ao:sourceView>ops.vw_incident_details</ao:sourceView>
    <ao:warehouseGrain>one row per operational incident</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalIncidentFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse fact record at one row per operational incident.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Operational Incident Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
    <ao:foreignKey>airport_id -&gt; dim_airport.airport_id</ao:foreignKey>
    <ao:foreignKey>gate_id -&gt; dim_gate.gate_id</ao:foreignKey>
    <ao:primaryKey>incident_id</ao:primaryKey>
    <ao:sourceTable>fact_operational_incidents</ao:sourceTable>
    <ao:sourceView>ops.vw_incident_details</ao:sourceView>
    <ao:warehouseGrain>one row per operational incident</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
