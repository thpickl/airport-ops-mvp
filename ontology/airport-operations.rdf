  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#RampServiceTaskFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
