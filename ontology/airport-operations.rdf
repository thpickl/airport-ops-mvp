  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PhysicalAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A physical item, equipment instance, meter, or aircraft instance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Physical Asset</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DomainEntity" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BusinessEntity" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#Observation" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PhysicalLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A geographic or built-environment location in the airport hierarchy.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Physical Location</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#DomainEntity" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#BusinessEntity" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#Observation" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent" />
    <owl:disjointWith rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#PhysicalAsset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PseudonymousCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A pseudonymous synthetic customer profile without direct identifiers.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Pseudonymous Customer</rdfs:label>
