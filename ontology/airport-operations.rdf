    <ao:sourceView>ops.vw_fact_passenger_flow</ao:sourceView>
    <ao:warehouseGrain>one row per checkpoint and 15-minute interval</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PassengerQueueFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Warehouse fact record at one row per checkpoint and 15-minute observation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Passenger Queue Fact Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#FactRecord" />
    <ao:foreignKey>airport_id -&gt; dim_airport.airport_id</ao:foreignKey>
    <ao:foreignKey>date_key -&gt; dim_date.date_key</ao:foreignKey>
    <ao:primaryKey>queue_metric_id</ao:primaryKey>
    <ao:sourceTable>fact_passenger_queue_metrics</ao:sourceTable>
    <ao:sourceView>ops.vw_fact_passenger_flow</ao:sourceView>
    <ao:warehouseGrain>one row per checkpoint and 15-minute observation</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#PersonaScorecard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">Gold analytical product at one row per airport and persona.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
