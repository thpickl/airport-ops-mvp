    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment xml:lang="en">A synthetic maintenance observation associated with an airport asset type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology" />
    <rdfs:label xml:lang="en">Maintenance Event</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://data.fictional-airport-group.example/airport-operations/ontology#OperationalEvent" />
    <ao:primaryKey>maintenance_id</ao:primaryKey>
    <ao:sourceTable>fact_maintenance_events</ao:sourceTable>
    <ao:sourceView>ops.vw_fact_maintenance_events</ao:sourceView>
    <ao:warehouseGrain>one row per maintenance event</ao:warehouseGrain>
  </rdf:Description>
  <rdf:Description rdf:about="https://data.fictional-airport-group.example/airport-operations/ontology#MaintenanceEventFactRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
